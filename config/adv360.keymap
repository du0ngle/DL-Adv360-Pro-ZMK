#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      m0: m0 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_EQ_OR_PLUS";
          #binding-cells = <0>;
          bindings = <&kp EQUAL>, <&kp PLUS>;  // = <> +
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
      };

      m1: m1 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_STAR_OR_N1";
          #binding-cells = <0>;
          bindings = <&kp STAR>, <&kp N1>; // * <> 1
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
      };

      m2: m2 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_LBKT_OR_N2";
          #binding-cells = <0>;
          bindings = <&kp LBKT>, <&kp N2>; // [ <> 2
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
      };

      m3: m3 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_LBRC_OR_N3";
          #binding-cells = <0>;
          bindings = <&kp LBRC>, <&kp N3>; // { <> 3
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
          };

          m4: m4 {
              compatible = "zmk,behavior-mod-morph";
              label = "SYM_LPAR_OR_N4";
              #binding-cells = <0>;
              bindings = <&kp LPAR>, <&kp N4>; // ( <> 4
              mods = <(MOD_LSFT|MOD_RSFT)>;
              morph-mode = "exclusive";
          };

          m5: m5 {
              compatible = "zmk,behavior-mod-morph";
              label = "SYM_HASH_OR_N5";
              #binding-cells = <0>;
              bindings = <&kp HASH>, <&kp N5>; // # <> 5
              mods = <(MOD_LSFT|MOD_RSFT)>;
              morph-mode = "exclusive";
          };

          m6: m6 {
              compatible = "zmk,behavior-mod-morph";
              label = "SYM_CARET_OR_N6";
              #binding-cells = <0>;
              bindings = <&kp CARET>, <&kp N6>; // ^ <> 6
              mods = <(MOD_LSFT|MOD_RSFT)>;
              morph-mode = "exclusive";
          };

          m7: m7 {
              compatible = "zmk,behavior-mod-morph";
              label = "SYM_RPAR_OR_N7";
              #binding-cells = <0>;
              bindings = <&kp RPAR>, <&kp N7>; // ) <> 7
              mods = <(MOD_LSFT|MOD_RSFT)>;
              morph-mode = "exclusive";
          };

          m8: m8 {
              compatible = "zmk,behavior-mod-morph";
              label = "SYM_RBRC_OR_N8";
              #binding-cells = <0>;
              bindings = <&kp RBRC>, <&kp N8>; // } <> 8
              mods = <(MOD_LSFT|MOD_RSFT)>;
              morph-mode = "exclusive";
      };

      m9: m9 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_RBKT_OR_N9";
          #binding-cells = <0>;
          bindings = <&kp RBKT>, <&kp N9>; // ] <> 9
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
      };

      m10: m10 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_DLLR_OR_N0";
          #binding-cells = <0>;
          bindings = <&kp DLLR>, <&kp N0>; // $ <> 0
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
      };

      m11: m11 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_MINUS_OR_UNDERSCORE"; // - <> _
          #binding-cells = <0>;
          bindings = <&kp MINUS>, <&kp UNDERSCORE>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
      };

      m12: m12 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_SQT_OR_DQT"; // ' <> "
          #binding-cells = <0>;
          bindings = <&kp SQT>, <&kp DQT>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
      };

      m13: m13 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_SEMI_OR_COLON"; // ; <> :
          #binding-cells = <0>;
          bindings = <&kp SEMI>, <&kp COLON>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
      };

      m14: m14 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_COMMA_OR_LT"; // , <> <
              #binding-cells = <0>;
              bindings = <&kp COMMA>, <&kp LT>;
              mods = <(MOD_LSFT|MOD_RSFT)>;
              morph-mode = "exclusive";
      };

      m15: m15 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_DOT_OR_GT"; // . <> >
          #binding-cells = <0>;
          bindings = <&kp DOT>, <&kp GT>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
      };

      m16: m16 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_FSLH_OR_QMARK"; // / <> ?
          #binding-cells = <0>;
          bindings = <&kp FSLH>, <&kp QMARK>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
      };

      m17: m17 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_BSLH_OR_PIPE"; // \ <> |
          #binding-cells = <0>;
          bindings = <&kp BSLH>, <&kp PIPE>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
      };

      m18: m18 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_GRAVE_OR_TILDE"; // ` <> ~
          #binding-cells = <0>;
          bindings = <&kp GRAVE>, <&kp TILDE>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
      };

      m19: m19 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_PERCENT_OR_AT"; // % <> @
          #binding-cells = <0>;
          bindings = <&kp PERCENT>, <&kp AT>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
      };

      m20: m20 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_AMPS_OR_PERCENT"; // & <> %
          #binding-cells = <0>;
          bindings = <&kp AMPS>, <&kp PERCENT>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
      };

      m21: m21 {
          compatible = "zmk,behavior-mod-morph";
          label = "SYM_EXCL_OR_AT"; // ! <> @
          #binding-cells = <0>;
          bindings = <&kp EXCL>, <&kp AT>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
          morph-mode = "exclusive";
      };

    };

    keymap {
        compatible = "zmk,keymap";



    // 0
    default_layer {
                display-name = "Base";
                bindings = <

                    &m0     &m1     &m2     &m3     &m4     &m5     &tog 1                                                  &mo 3     &m6     &m7     &m8     &m9     &m10    &m11
                    &kp TAB  &kp Q   &kp W   &kp E   &kp R   &kp T   &none                                                  &none     &kp Y   &kp U   &kp I   &kp O   &kp P   &m17
                    &kp ESC  &kp A   &kp S   &kp D   &kp F   &kp G   &kp RALT        &kp LCTRL &kp DEL  &kp LGUI &kp RCTRL       &none    &kp H   &kp J   &kp K   &kp L   &m13    &m12
                    &kp LSHFT    &kp Z   &kp X   &kp C   &kp V   &kp B                          &kp HOME  &kp PG_UP                    &kp N   &kp M   &m14    &m15    &m16   &kp RSHFT 
                    &mo 2    &m18    &m19    &kp LEFT &kp RIGHT          &kp BSPC &mo 4    &kp END  &kp PG_DN &kp ENTER  &kp SPACE          &kp DOWN &kp UP  &m20    &m21    &mo 2


                >;
            };


     // 1
    keypad {
        display-name = "Kp";
        bindings = <
            &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                           &mo 3 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
            &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
            &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
            &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
            &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0              &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 2
        >;
    };


     // 2
    fn {
        display-name = "Fn";
        bindings = <
            &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
            &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
            &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
            &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
            &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
        >;
    };



    // 3
    mod {
          bindings = <
            &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
            &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
            &none &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &rgb_ug RGB_MEFS_CMD 5 &none        &none        &none        &none &none &none
            &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
            &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
          >;
        };


        // 4
        alt_layer {
            bindings = <
                &kp F1 &macro_go_view_1 &macro_go_view_2 &macro_go_view_3 &macro_go_view_4 &macro_go_view_5 &tog 2                                           &mo 4 &macro_go_view_6 &macro_go_view_7 &macro_go_view_8 &macro_go_view_9 &kp F11 &kp F12
                &macro_alt_tab &macro_alt_f4 &none &macro_file_explorer &none &macro_open_terminal &none                                           &none &none &none &none &none  &none  &none
                &tog 1 &trans &trans &trans &macro_ctrl_f &trans  &none        &trans &macro_ctrl_alt_del &trans &trans        &none &macro_left_screen &macro_min_screen &macro_max_screen &macro_right_screen  &trans  &trans
                &trans &macro_ctrl_z &macro_ctrl_x &macro_ctrl_c &macro_ctrl_v &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
                &trans &trans &trans &macro_shift_ctrl_left &macro_shift_ctrl_right               &macro_ctrl_backspace &trans &trans &trans &trans &trans              &macro_shift_down &macro_shift_up &trans  &trans  &trans
            >;
        };


    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
